  {
    "name": "combat_act",
    "description": "Play the battle. Steps run in order: play_card (with target when the card needs one), use_potion, discard_potion, end_turn, select (the complete final choice for an open selection), interact (a listed special operation). Each step is checked when it is reached, so an earlier step can make a later one legal; execution stops at the first step that cannot run and the result says which steps ran. Queue the whole line when no later step depends on something still unrevealed; otherwise end at the revealing step and decide again. A forced single-candidate selection resolves itself. Omit target only when exactly one legal target exists.",
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "play_card"
                  },
                  "card": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Card ref; it may be a card an earlier step brings into hand."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "card"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "use_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "discard_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "end_turn"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interact"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Operation ref from the current choice."
                  }
                },
                "required": [
                  "kind",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "select"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0,
                    "uniqueItems": true,
                    "description": "Refs of every chosen candidate; empty declines when min is 0."
                  }
                },
                "required": [
                  "kind",
                  "refs"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "description": "One or two short lines: what the chosen line does to how the fight ends (kill turn, deadline, or setup), the HP it costs, the main alternative, and any chance of death. Use names, not refs."
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_act",
    "description": "Perform non-combat operations other than card offers and travel. Steps run in order: interact (a listed reward, shop, event, rest-site, or special operation), select (the complete final choice for an open selection), use_potion, discard_potion. Each step is checked when it is reached, so an earlier step can make a later one legal; execution stops at the first step that cannot run. Queue several steps when no later one depends on something still unrevealed. A screen may close itself after its last reward; do not queue a close for it. Card offers go through run_deck_choice, travel through run_plan and run_next.",
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interact"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Operation ref from the current choice."
                  }
                },
                "required": [
                  "kind",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "use_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "discard_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "select"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0,
                    "uniqueItems": true,
                    "description": "Refs of every chosen candidate; empty declines when min is 0."
                  }
                },
                "required": [
                  "kind",
                  "refs"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "description": "One short line: what was chosen and why, using names, not refs."
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_deck_choice",
    "description": "Resolve the card reward: take one of its cards or skip it. This ends the decision; a run_notes call comes before it in the same response.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offer": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card offer."
            },
            "choice": {
              "const": "take"
            },
            "card": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card taken."
            },
            "reason": {
              "type": "string",
              "description": "One short line: what a normal turn gains with this card over that one, or over skipping."
            },
            "for": {
              "type": "string",
              "enum": [
                "core",
                "energy",
                "draw",
                "block",
                "transition"
              ],
              "description": "The job this card does for the deck: core, support (energy, draw, or block), or transition."
            },
            "over": {
              "type": "string",
              "minLength": 1,
              "description": "Native definition ID of the best owned card that does the same job. Omit when no owned card does that job."
            }
          },
          "required": [
            "offer",
            "choice",
            "card",
            "for",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "offer": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card offer."
            },
            "choice": {
              "const": "skip"
            },
            "reason": {
              "type": "string",
              "description": "One short line: why no candidate is taken."
            }
          },
          "required": [
            "offer",
            "choice",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  {
    "name": "run_notes",
    "description": "Read or rewrite the run's strategy notes, which Combat receives at the start of each battle. mode=write replaces each field it supplies and keeps the others. core: native definition IDs of the cards and relics the deck is built around. plan: how the core's turn goes and what it still lacks. other: resource reservations and one-time facts needed later that no current state shows. Name objects by native definition ID, never by refs. Delete what is obsolete, do not restate current state, and write nothing when no decision changes.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "read"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "write"
            },
            "plan": {
              "type": "string",
              "maxLength": 300
            },
            "other": {
              "type": "string"
            },
            "core": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "maxItems": 5,
              "uniqueItems": true
            }
          },
          "required": [
            "mode"
          ],
          "minProperties": 2,
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "core"
              ]
            },
            {
              "required": [
                "plan"
              ]
            },
            {
              "required": [
                "other"
              ]
            }
          ]
        }
      ]
    }
  },
  {
    "name": "run_plan",
    "description": "Set the remaining route as directed edges between current-act map node IDs, starting at the current node with exactly one next destination; later branches are allowed. It replaces the previous plan and does not move. The result reports acceptance, map drawing, and interface restoration separately.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One short line: what this route is for."
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reason",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_next",
    "description": "Enter the next node of the current plan. It fails without moving when a pending choice or the game blocks travel; resolve the choice or replace the plan.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One short line."
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  }
]
