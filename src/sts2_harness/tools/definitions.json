  {
    "name": "run_skill",
    "description": "Read configured guidance documents. mode=list shows what exists (id, name, description), filtered by text and paged with offset and limit. mode=read returns one document by id, or one of its listed resources when resource is given. Read-only.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "list"
            },
            "text": {
              "type": "string",
              "description": "Case-insensitive substring in the document id, name, or description."
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 20
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "read"
            },
            "id": {
              "type": "string",
              "minLength": 1
            },
            "resource": {
              "type": "string",
              "minLength": 1,
              "description": "A resource key listed by that document."
            }
          },
          "required": [
            "mode",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  {
    "name": "combat_skill",
