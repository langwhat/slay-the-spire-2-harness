[
  {
    "name": "run_inspect",
    "description": "Read public information missing from the current sections: state refreshes the view and map reads the act map. Read-only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "state",
            "map"
          ]
        }
      },
      "required": [
        "area"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_knowledge",
    "description": "Look up game definitions, including objects you do not have. Objects shown in the state already carry their rules and next upgrade, and supplied guidance already includes their mechanism notes; look up only what neither shows. mode=lookup returns the full entries for up to 20 native IDs; a card entry includes its next upgrade. mode=search finds definitions whose ID, name, or text contains every term in text; narrow it with category and, for cards, with filters (pools, types, rarities, energy_costs: values inside one filter are alternatives, different filters combine). It returns 5 matches unless limit is set (up to 20); continue with offset=next_offset. mode=catalog lists the categories and filter values. Results are base definitions; current prices, costs, and instance values come from the state. Read-only.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "catalog"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "search"
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "description": "A category from mode=catalog; omit to search all."
            },
            "text": {
              "type": "string",
              "description": "Terms that must all appear."
            },
            "filters": {
              "type": "object",
              "properties": {
                "pools": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "CARD_POOL.COLORLESS_CARD_POOL",
                      "CARD_POOL.CURSE_CARD_POOL",
                      "CARD_POOL.DEFECT_CARD_POOL",
                      "CARD_POOL.DEPRECATED_CARD_POOL",
                      "CARD_POOL.EVENT_CARD_POOL",
                      "CARD_POOL.IRONCLAD_CARD_POOL",
                      "CARD_POOL.NECROBINDER_CARD_POOL",
                      "CARD_POOL.QUEST_CARD_POOL",
                      "CARD_POOL.REGENT_CARD_POOL",
                      "CARD_POOL.SILENT_CARD_POOL",
                      "CARD_POOL.STATUS_CARD_POOL",
                      "CARD_POOL.TOKEN_CARD_POOL"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "types": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "attack",
                      "curse",
                      "none",
                      "power",
                      "quest",
                      "skill",
                      "status"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "rarities": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "enum": [
                      "ancient",
                      "basic",
                      "common",
                      "curse",
                      "event",
                      "quest",
                      "rare",
                      "status",
                      "token",
                      "uncommon"
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                },
                "energy_costs": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "const": "X"
                      }
                    ]
                  },
                  "minItems": 1,
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            },
            "offset": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 5
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "required": [
                  "filters"
                ]
              },
              "then": {
                "properties": {
                  "category": {
                    "const": "card"
                  }
                },
                "required": [
                  "category"
                ]
              }
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "lookup"
            },
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "maxItems": 20,
              "uniqueItems": true
            }
          },
          "required": [
            "mode",
            "ids"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  {
    "name": "combat_inspect",
    "description": "Read public information missing from the current sections: state refreshes the view, map reads the act map, and combat_history reads this battle's card history only during an active battle, not its review. Read-only.",
    "input_schema": {
      "type": "object",
      "properties": {
        "area": {
          "type": "string",
          "enum": [
            "state",
            "map",
            "combat_history"
          ]
        }
      },
      "required": [
        "area"
      ],
      "additionalProperties": false
    }
  },
