      "oneOf": [
        {
          "type": "object",
          "properties": {
            "area": {
              "enum": [
                "state",
                "map",
                "combat_history"
              ]
            }
          },
          "required": [
            "area"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "area": {
              "const": "upgrades"
            },
            "refs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1,
              "uniqueItems": true,
              "description": "Current card refs from one area; omit to preview the owned deck."
            }
          },
          "required": [
            "area"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
