  {
    "name": "combat_act",
    "description": "Play the battle. Steps run in order: play_card (with target when the card needs one), use_potion, discard_potion, end_turn, select (the complete final choice for an open selection), interact (a listed special operation). Each step is checked when it is reached, so an earlier step can make a later one legal; execution stops at the first step that cannot run and the result says which steps ran. Queue the whole line when no later step depends on something still unrevealed; otherwise end at the revealing step and decide again. A forced single-candidate selection resolves itself. Omit target only when exactly one legal target exists.",
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "play_card"
                  },
                  "card": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Card ref; it may be a card an earlier step brings into hand."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "card"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "use_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "discard_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "end_turn"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interact"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Operation ref from the current choice."
                  }
                },
                "required": [
                  "kind",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "select"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0,
                    "uniqueItems": true,
                    "description": "Refs of every chosen candidate; empty declines when min is 0."
                  }
                },
                "required": [
                  "kind",
                  "refs"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "description": "One or two short lines: the chosen line with the HP expected to be lost through the next enemy attack, the main alternative with its loss, and any chance of death. Use names, not refs."
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_act",
    "description": "Perform non-combat operations other than card offers and travel. Steps run in order: interact (a listed reward, shop, event, rest-site, or special operation), select (the complete final choice for an open selection), use_potion, discard_potion. Each step is checked when it is reached, so an earlier step can make a later one legal; execution stops at the first step that cannot run. Queue several steps when no later one depends on something still unrevealed. A screen may close itself after its last reward; do not queue a close for it. Card offers go through run_deck_choice, travel through run_plan and run_next.",
    "input_schema": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "interact"
                  },
                  "action": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Operation ref from the current choice."
                  }
                },
                "required": [
                  "kind",
                  "action"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "use_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  },
                  "target": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "discard_potion"
                  },
                  "potion": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Potion ref."
                  }
                },
                "required": [
                  "kind",
                  "potion"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "select"
                  },
                  "refs": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 0,
                    "uniqueItems": true,
                    "description": "Refs of every chosen candidate; empty declines when min is 0."
                  }
                },
                "required": [
                  "kind",
                  "refs"
                ],
                "additionalProperties": false
              }
            ]
          },
          "minItems": 1
        },
        "reason": {
          "type": "string",
          "description": "One short line: what was chosen and why, using names, not refs."
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_deck_choice",
    "description": "Resolve one card offer: take one of its cards or skip it. Call once per offer and decide a later offer after the earlier one has changed the deck. class says what the card is to this deck: engine (adds a link, more triggers, or earlier assembly to its strongest turn), pivot (forms a stronger turn with owned cards), answer (closes a named shortfall), or filler (contributes only its own numbers). links lists the native definition IDs of the owned cards and relics it works with; omit the +N upgrade suffix shown in state view keys.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "offer": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card offer."
            },
            "choice": {
              "const": "take"
            },
            "card": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card taken."
            },
            "class": {
              "enum": [
                "engine",
                "pivot",
                "answer",
                "filler"
              ]
            },
            "links": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "description": "Native definition IDs of the owned cards and relics it works with; empty for filler."
            },
            "reason": {
              "type": "string",
              "description": "One short line: the turn this card changes and by how much, using names."
            }
          },
          "required": [
            "offer",
            "choice",
            "card",
            "class",
            "links",
            "reason"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "offer": {
              "type": "string",
              "minLength": 1,
              "description": "Ref of the card offer."
            },
            "choice": {
              "const": "skip"
            },
            "reason": {
              "type": "string",
              "description": "One short line: why no candidate beats the deck's average draw."
            }
          },
          "required": [
            "offer",
            "choice",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  {
    "name": "run_notes",
    "description": "Read or rewrite the run's strategy memo, which Combat receives at the start of each battle. Keep four sections in this order. ENGINE: its kind (growth, cycle, or burst), its cards, the engine turn in play order, and the turn by which it is normally ready. WANTS: at most three effects that would make the engine ready sooner or keep the deck alive until then, each with the fights it is for; delete a want once a card answers it. FILLER: owned cards outside ENGINE and WANTS, in removal order. EVIDENCE: measured results for or against the sections above: the fight, the turn the engine was ready, and what limited it. Below them keep resource reservations and one-time facts needed later that no current state shows. Name objects by localized name and native definition ID, never by refs. Keep the memo short: delete what is obsolete, do not restate current state, and leave it unchanged when no decision changes. mode=read returns the memo; replace rewrites it; edit swaps one exact, unique old_text for new_text. A rejected edit changed nothing.",
    "input_schema": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "read"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "replace"
            },
            "text": {
              "type": "string",
              "description": "Complete replacement strategy notes."
            }
          },
          "required": [
            "mode",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "edit"
            },
            "old_text": {
              "type": "string",
              "minLength": 1
            },
            "new_text": {
              "type": "string",
              "description": "Replacement; empty deletes old_text."
            }
          },
          "required": [
            "mode",
            "old_text",
            "new_text"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  {
    "name": "run_plan",
    "description": "Set the remaining route as directed edges between current-act map node IDs, starting at the current node with exactly one next destination; later branches are allowed. It replaces the previous plan and does not move. The result reports acceptance, map drawing, and interface restoration separately.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One short line: what this route is for."
        },
        "edges": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "properties": {
              "from": {
                "type": "string",
                "minLength": 1
              },
              "to": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "from",
              "to"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "reason",
        "edges"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "run_next",
    "description": "Enter the next node of the current plan. It fails without moving when a pending choice or the game blocks travel; resolve the choice or replace the plan.",
    "input_schema": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 1,
          "description": "One short line."
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false
    }
  }
]
