<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Sts2Mod</RootNamespace>
    <!-- Slay the Spire 2 loads <id>.dll directly without side-by-side assemblies. -->
    <AssemblyName>sts2agent</AssemblyName>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\Sts2Mod.Core\**\*.cs"
             Exclude="..\Sts2Mod.Core\bin\**;..\Sts2Mod.Core\obj\**"
             LinkBase="Core" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sts2Mod.Native.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="mod_manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
