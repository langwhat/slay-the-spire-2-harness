# Copy to .env and supply your own model and credentials.
STS2_DRIVER=builtin
STS2_USER_INPUT=false
# Minimal mode is enabled by default for builtin driving; set false for full mode.
# STS2_MINIMAL=false

# --- Option 1: OpenAI Responses (default) ---
LLM_PROTOCOL=responses
LLM_MODEL=your-model-id
LLM_BASE_URL=https://api.openai.com/v1
LLM_AUTH=bearer
LLM_API_KEY=replace-locally
LLM_REASONING_EFFORT=

# --- Option 2: OpenAI-compatible Chat Completions (proxies / third-party providers) ---
# LLM_PROTOCOL=chat-completions
# LLM_MODEL=your-model-id
# LLM_BASE_URL=https://your-provider.example/v1
# LLM_AUTH=bearer
# LLM_API_KEY=replace-locally

# --- Option 3: Anthropic Messages ---
# LLM_PROTOCOL=messages
# LLM_MODEL=your-model-id
# LLM_BASE_URL=https://api.anthropic.com
# LLM_AUTH=api-key
# LLM_API_KEY=replace-locally
# LLM_REASONING_EFFORT=high

LLM_REQUEST_TIMEOUT_S=3600
LLM_EXTRA_RETRIES=25
LLM_CONTEXT_WINDOW=300000
# Enable only after verifying this exact Responses endpoint's HTTP 400 context_too_large code.
LLM_CAPACITY_VERIFIED_ENDPOINT=
