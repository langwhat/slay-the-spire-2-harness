# Copy to .env and supply your own model and credentials.
STS2_DRIVER=builtin
LLM_PROTOCOL=responses
LLM_MODEL=your-model-id
LLM_BASE_URL=https://api.openai.com/v1
LLM_AUTH=bearer
LLM_API_KEY=replace-locally
LLM_REQUEST_TIMEOUT_S=3600
LLM_EXTRA_RETRIES=25
LLM_CONTEXT_WINDOW=300000
# Enable only after verifying this exact Responses endpoint's HTTP 400 context_too_large code.
LLM_CAPACITY_VERIFIED_ENDPOINT=
